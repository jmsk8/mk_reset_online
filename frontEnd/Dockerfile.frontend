# Stage 1: Build dependencies
FROM python:3.10-slim AS builder

WORKDIR /build

COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Runtime
FROM python:3.10-slim

WORKDIR /app

RUN useradd -m -u 1000 appuser

COPY --from=builder /root/.local /home/appuser/.local

COPY frontend.py .
COPY templates/ templates/
COPY static/ static/

ENV PATH=/home/appuser/.local/bin:$PATH

USER appuser

EXPOSE 5000

# Workers threadés : le service attend surtout le réseau (appels au backend).
# Le timeout gunicorn (30 s) doit rester au-dessus de celui de backend_request (5 s).
CMD ["gunicorn", "-w", "2", "-k", "gthread", "--threads", "8", \
     "--timeout", "30", "-b", "0.0.0.0:5000", "frontend:app"]
